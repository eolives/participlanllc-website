{
  "name": "biddeford-charter-code",
  "version": "0.1.0",
  "description": "MCP server for the City of Biddeford, ME City Charter",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-assistant",
    "biddeford",
